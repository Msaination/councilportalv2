# Copy to python/.env and fill in real values. Never commit .env itself.
#
# Precedence: real environment variables (Docker / systemd / Windows setx)
# always win over this file. Sibling-repo files (authentik/.env, CMS/.env.local)
# are only local-dev fallbacks for keys this file does not set.

# ── Django ───────────────────────────────────────────────
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-this-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────
# Leave POSTGRES_HOST unset to use the SQLite fallback (dev only).
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=council_portal
# POSTGRES_USER=council
# POSTGRES_PASSWORD=change-this

# ── CORS / frontend ──────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Supabase (complaints gateway, server-side only) ──────
# The portal calls the Supabase REST API — it does not open a Postgres socket.
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# Supabase's newer name:
SUPABASE_SECRET_KEY=
# Legacy name, still accepted if SUPABASE_SECRET_KEY is empty:
# SUPABASE_SERVICE_ROLE_KEY=

# ── Authentik / OIDC (optional; blank disables SSO) ──────
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/oidc/callback/
AUTHENTIK_API_URL=http://localhost:9080
AUTHENTIK_ADMIN_TOKEN=
